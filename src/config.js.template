  labelOverview:     'off',               // 'weekly' | 'monthly' | 'off'
  missingInfo:       'off',               // 'weekly' | 'monthly' | 'off'
  dataQuality:       'off',               // 'weekly' | 'monthly' | 'off'
  autoLabeling:      'off',               // 'weekly' | 'monthly' | 'off'
};


