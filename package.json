{
  "name": "google-contacts-scripts",
  "version": "1.0.0",
  "description": "Google Apps Script for auditing and reporting on Google Contacts data quality",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "test": "jest",
    "deploy": "pnpm test && pnpx @google/clasp push"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.0",
    "jest": "^30.0.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
